{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-06",
	// enable_request_signal: make request.signal fire when the client
	// disconnects -- without it, pressing stop mid-transcript aborted only
	// the browser's fetch while the server kept paying for the OpenRouter
	// calls (verified: cancelled requests still ran to a 200). Also lets
	// api/stream.ts drop its upstream fetches the moment a listener leaves.
	"compatibility_flags": ["global_fetch_strictly_public", "enable_request_signal"],
	"name": "eidolon",
	// No public workers.dev URL: visitors arrive through the ghost-pages
	// proxy (ghost.purr.io), which reaches this Worker over a service binding.
	"workers_dev": false,
	"preview_urls": false,
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Per-client rate limiter (src/lib/rateLimiter.ts), exported from
	// src/worker.ts. SQLite-backed: the only DO storage on the Free plan.
	"durable_objects": {
		"bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }]
}
