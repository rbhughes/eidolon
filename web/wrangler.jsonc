{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"ratelimits": [
		{
			// Guards the OpenRouter-backed endpoint, which costs real money per
			// call -- this limit being tight, not the stream proxy's, is what
			// actually protects the budget.
			"name": "RATE_LIMIT_TRANSCRIBE",
			"namespace_id": "1001",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			// Guards the station-stream proxy. Looser: a single tune-in opens
			// one request per station (9), and legitimate use re-tunes a few
			// times a minute.
			"name": "RATE_LIMIT_STREAM",
			"namespace_id": "1002",
			"simple": { "limit": 60, "period": 60 }
		}
	]
}