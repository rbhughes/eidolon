---
import { STATIONS } from '../data/stations';

const stationNames = STATIONS.map((s) => s.name);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>Eidolon — a spirit box, debugged</title>
		<link rel="canonical" href="https://ghost.purr.io/" />
		<meta
			name="description"
			content="A Halloween spirit box that hops live internet radio stations and lets two language models decide what the spirits said. Skeptic mode shows every step."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="purr.io" />
		<meta property="og:url" content="https://ghost.purr.io/" />
		<meta property="og:title" content="Eidolon — a spirit box, debugged" />
		<meta
			property="og:description"
			content="Think of a question, then invoke the spirits. Or switch to skeptic mode and watch every buffer, token and cent."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Creepster&family=Cormorant+Garamond:wght@500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body data-mode="spooky">
		<script is:inline>
			// Pick the mode before first paint so a saved "skeptic" doesn't
			// flash the spooky page first. The module script re-derives it.
			(function () {
				var m = location.hash.slice(1);
				if (m !== 'skeptic' && m !== 'spooky') {
					try {
						m = localStorage.getItem('eidolon-mode');
					} catch (e) {}
				}
				if (m === 'skeptic' || m === 'spooky') document.body.dataset.mode = m;
			})();
		</script>
		<div class="mode-toggle" role="group" aria-label="Display mode">
			<button type="button" data-set-mode="spooky" aria-pressed="true">spooky</button>
			<button type="button" data-set-mode="skeptic" aria-pressed="false">skeptic</button>
		</div>

		<!-- skeptic: purr.io subdomain chrome -->
		<nav class="topnav skeptic-only">
			<a class="logo" href="https://purr.io" aria-label="purr.io"><img src="/purrio_2026.png" alt="purr.io logo" /></a>
			<span class="brand">Eidolon</span>
			<span class="vintage">Halloween 2026 &middot; mostly for fun</span>
		</nav>
		<header class="masthead skeptic-only">
			<h1>A spirit box, <em>debugged.</em></h1>
			<p class="tagline">
				A spirit box sweeps across radio stations so quickly that only fragments of speech get through, and believers
				hear the dead in the gaps. This one hops nine live internet radio stations, plays a two-second snippet from each,
				and hands exactly what you heard to two language models to transcribe and translate. Every step is logged below,
				so you can watch precisely how little of it is supernatural.
			</p>
		</header>

		<!-- spooky: minimal -->
		<header class="spooky-head spooky-only">
			<h1>Eidolon</h1>
			<p class="invocation">Think of a question. Hold it in your mind.<br />When you are ready, invoke the spirits.</p>
			<p class="hint-small">sound on &middot; then ask them what they said</p>
		</header>

		<main class="console">
			<canvas class="waveform spooky-only" id="waveform" aria-hidden="true"></canvas>
			<div class="station skeptic-only" id="station">-- not tuned in --</div>
			<div class="controls">
				<button type="button" id="tune">invoke the spirits!</button>
				<button type="button" id="capture" disabled>what did they say?</button>
				<button type="button" id="stop" disabled>banish the spirits</button>
			</div>
		</main>

		<section class="oracle spooky-only" aria-live="polite">
			<p class="oracle-latest" id="oracle-latest"></p>
			<ol class="oracle-earlier" id="oracle-earlier"></ol>
		</section>

		<section class="panels skeptic-only">
			<div class="panel">
				<h2>Transcript</h2>
				<p class="panel-note">Everything played since the previous transcript, sent as one clip.</p>
				<div class="log" id="log">
					<p class="hint">Tune in, listen for a while, then press <strong>transcript</strong>.</p>
				</div>
			</div>
			<div class="panel debug-panel">
				<h2>Behind the scenes</h2>
				<p class="panel-note">
					Every step the page and server take, as it happens: connections, snippet picks, playback, model calls with their
					prompts, token counts and the cost OpenRouter reports.
				</p>
				<div class="debug-log" id="debug-log" role="log" aria-label="Debug log"></div>
			</div>
		</section>

		<article class="story skeptic-only">
			<h2>Mostly for fun</h2>
			<p>
				This is a Halloween toy and an excuse to learn something, nothing more. The models transcribe whatever the radio
				actually said, and speech-to-text models are famous for inventing confident words out of noise, which happens to be
				exactly the property a spirit box wants. If the dead really are reaching out through internet radio, they are
				fighting the same battles I was: a TLS handshake per station, a CORS policy written by the living, and a
				two-second burst of stale buffer every time they reconnect. One assumes the afterlife has better retry logic.
			</p>

			<h2>Internet radio is not a radio</h2>
			<p>
				The original Eidolon is a command-line tool that drives real radio hardware. Retuning a software-defined radio is
				nearly instant and the audio is live. An internet station is an HTTP stream instead, and getting a few seconds of
				it means DNS, a TLS handshake and the server&rsquo;s <em>burst-on-connect</em>: Icecast and StreamTheWorld
				servers send every new listener several seconds of pre-buffered audio so playback starts smoothly. Reconnect on
				every hop and you replay that catch-up burst each time; measured, it inflated the audio to about 3.5&times; real
				time. What the web version does instead:
			</p>
			<ul>
				<li>
					<strong>Stay connected.</strong> The server holds one connection per station open for the whole session and
					discards the first two seconds of each, so everything after that is live.
				</li>
				<li>
					<strong>Multiplex.</strong> Browsers allow six HTTP/1.1 connections per site, so nine open streams starved
					everything else, including the transcription request. The server merges all nine into one framed stream
					(<code>[station][length][bytes]</code>) that the page splits back apart, and it disconnects any listener that
					stops reading rather than buffering for them.
				</li>
				<li>
					<strong>Cut on frames.</strong> Playing the live edge in small pieces failed: an MP3 fragment decoded on its own
					starts in silence, and Firefox rejected 21 of 48 of them outright, losing 46% of the audio. Each hop now takes
					a station&rsquo;s latest two seconds, cut on validated MP3 frame boundaries with three warm-up frames for the
					decoder, and schedules it to start the instant the previous snippet ends.
				</li>
				<li>
					<strong>Transcribe what you heard.</strong> The transcript is assembled from the exact bytes that were played,
					not fetched again, so it cannot drift from what came out of your speakers.
				</li>
			</ul>

			<h2>The hardware version: RTL-SDR Blog V4</h2>
			<p>
				The command-line version listens through an{' '}
				<a href="https://www.rtl-sdr.com/v4/">RTL-SDR Blog V4</a>, an inexpensive USB software-defined radio built on the
				RTL2832U, a chip originally made for digital TV dongles, and an R828D tuner. The V4 adds a 1&nbsp;PPM
				temperature-compensated oscillator, a built-in HF upconverter, a bias tee and an aluminium case. Eidolon hops the
				US FM grid (odd tenths from 88.1&nbsp;MHz, 200&nbsp;kHz apart) and favours frequencies where an{' '}
				<code>rtl_power</code> scan found real stations, with some purely random hops kept for static. A web page
				can&rsquo;t reach a USB radio on a stranger&rsquo;s desk, hence internet radio here.
			</p>

			<h2>Models, tokens and cost</h2>
			<p>
				Speech-to-text is <code>mistralai/voxtral-mini-transcribe</code> through{' '}
				<a href="https://openrouter.ai">OpenRouter</a>, chosen for latency over Whisper-class models, at $0.003 per minute
				of audio. It doesn&rsquo;t translate, and most of these stations aren&rsquo;t in English, so a second call sends
				the transcript to <code>openai/gpt-4o-mini</code> with a one-paragraph system prompt ($0.15 per million input
				tokens, $0.60 per million output). A typical 30-second transcript costs about $0.0015 to transcribe and $0.00005
				to translate, roughly 650 transcripts per dollar. The log above shows the exact token counts and cost OpenRouter
				reports for each request. Transcription is limited to ten requests a minute per visitor, which is all the
				protection the budget needs.
			</p>
		</article>

		<footer class="skeptic-only">
			<p>
				Audio: public live streams from {stationNames.join(', ')}. No affiliation with any of them, living or otherwise.
			</p>
			<p class="colophon">A <a href="https://purr.io">purr.io</a> project &middot; &copy; 2026 &middot; built in the open</p>
		</footer>
		<footer class="spooky-foot spooky-only">
			<p>
				a <a href="https://purr.io">purr.io</a> project &middot; curious how it works?{' '}
				<button type="button" class="link-button" data-set-mode="skeptic">switch to skeptic mode</button>
			</p>
		</footer>

		<script>
			import { STATIONS, pickWeighted } from '../data/stations';
			import { StationBuffer } from '../lib/stationBuffer';
			import { SnippetPlayer } from '../lib/snippetPlayer';
			import { DebugLog } from '../lib/debugLog';
			import { Waveform } from '../lib/waveform';

			type Mode = 'skeptic' | 'spooky';

			const stationEl = document.getElementById('station') as HTMLDivElement;
			const tuneBtn = document.getElementById('tune') as HTMLButtonElement;
			const captureBtn = document.getElementById('capture') as HTMLButtonElement;
			const stopBtn = document.getElementById('stop') as HTMLButtonElement;
			const log = document.getElementById('log') as HTMLDivElement;
			const oracleLatest = document.getElementById('oracle-latest') as HTMLParagraphElement;
			const oracleEarlier = document.getElementById('oracle-earlier') as HTMLOListElement;
			const debug = new DebugLog(document.getElementById('debug-log') as HTMLDivElement);

			// Tried matching the CLI's chunk_seconds (1.5s) directly -- measured
			// regression, not an improvement: "since last capture" means a
			// capture after a long gap accumulates one segment per hop, and at
			// 1.5s that's ~16-20 station/language switches in a 30s window.
			// Voxtral can't produce anything coherent from that much rapid
			// language-switching (confirmed: a 30s/9-language capture came back
			// as 3 garbled sentences). The CLI doesn't hit this as hard in
			// practice because marking promptly keeps "since last mark" short;
			// a literal 1.5s hop rate here makes even a *patient* capture
			// incoherent. 3000ms keeps enough same-station context per segment
			// for transcription to work; the "capture promptly for a
			// single-fragment clip" idea still holds at this rate too, it just
			// isn't driven by making every hop globally faster.
			//
			// Now a hop is one snippet: SNIPPET_S of a station's most recent
			// audio, played whole (see snippetPlayer.ts). 2s per user
			// preference for shorter snippets -- re-measured first, with clean
			// frame-aligned cuts: 3 recordings x {3, 2, 1.5}s, same audio per
			// recording. Mean words per audio-second 1.38 / 1.20 / 1.29, with
			// per-clip spread (0.68-1.86) far larger than the differences, and
			// the ASR deterministic per clip -- no collapse like the 1.5s
			// regression above showed. MIN_SNIPPET_S lets a station that was
			// just played, or is still connecting, still contribute a shorter
			// one rather than being skipped outright.
			const SNIPPET_S = 2;
			const MIN_SNIPPET_S = 1;
			// Queue the next snippet once less than this much is left playing
			// -- decoding a 3s snippet takes milliseconds, so this is pure
			// margin against timer jitter.
			const QUEUE_AHEAD_S = 0.75;
			const TICK_MS = 100;
			// Tries per tick to find a station with enough fresh audio.
			const PICK_ATTEMPTS = 6;
			const BUFFER_WINDOW_MS = 60_000;
			const MAX_CAPTURE_MS = 60_000; // safety cap if you wait a while before capturing
			const STATS_INTERVAL_MS = 10_000;
			const MODE_KEY = 'eidolon-mode';

			let mode: Mode = 'spooky';
			let hopping = false;
			let hopLoopGeneration = 0;
			let statsTimer: ReturnType<typeof setInterval> | null = null;
			let tunedIn = false;
			let transcribing = false;
			// Aborts the in-flight /api/transcribe request when stop is pressed.
			let transcribeAbort: AbortController | null = null;
			let lastCaptureTime = Date.now();
			let sessionCost = 0;
			let transcriptCount = 0;
			let waitingLogged = false;

			const buffer = new StationBuffer(STATIONS, BUFFER_WINDOW_MS);
			const player = new SnippetPlayer();
			const waveform = new Waveform(document.getElementById('waveform') as HTMLCanvasElement, player.analyser);

			const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
			const fmtBytes = (n: number) => `${n.toLocaleString('en-US')} B`;
			const fmtUsd = (n: number) => `$${n.toFixed(6)}`;
			const fmtClock = (ms: number) => new Date(ms).toLocaleTimeString('en-US', { hour12: false });
			const num = (o: Record<string, unknown> | undefined, k: string) => (typeof o?.[k] === 'number' ? (o[k] as number) : 0);

			// --- mode -------------------------------------------------------

			function initialMode(): Mode {
				const fromHash = location.hash.slice(1);
				if (fromHash === 'skeptic' || fromHash === 'spooky') return fromHash;
				try {
					const saved = localStorage.getItem(MODE_KEY);
					if (saved === 'skeptic' || saved === 'spooky') return saved;
				} catch {
					// Storage blocked -- default is fine.
				}
				return 'spooky';
			}

			function setMode(next: Mode) {
				mode = next;
				document.body.dataset.mode = next;
				for (const b of document.querySelectorAll<HTMLButtonElement>('.mode-toggle [data-set-mode]')) {
					b.setAttribute('aria-pressed', String(b.dataset.setMode === next));
				}
				try {
					localStorage.setItem(MODE_KEY, next);
				} catch {
					// Storage blocked -- the toggle still works for this visit.
				}
				history.replaceState(null, '', `#${next}`);
				renderButtons();
				if (next === 'skeptic') debug.scrollToEnd();
			}

			for (const b of document.querySelectorAll<HTMLButtonElement>('[data-set-mode]')) {
				b.addEventListener('click', () => {
					setMode(b.dataset.setMode as Mode);
					if (b.classList.contains('link-button')) window.scrollTo({ top: 0 });
				});
			}

			function renderButtons() {
				const spooky = mode === 'spooky';
				tuneBtn.textContent = tunedIn
					? spooky
						? 'the spirits are listening…'
						: 'tuned in'
					: spooky
						? 'invoke the spirits!'
						: 'tune in';
				captureBtn.textContent = transcribing
					? spooky
						? 'listening beyond the veil…'
						: 'transcribing…'
					: spooky
						? 'what did they say?'
						: 'transcript';
				stopBtn.textContent = spooky ? 'banish the spirits' : 'stop';
				tuneBtn.disabled = tunedIn;
				captureBtn.disabled = !tunedIn || transcribing;
				stopBtn.disabled = !tunedIn && !transcribing;
			}

			// --- listening --------------------------------------------------

			buffer.setEventSink((e) => {
				if (e.kind === 'connected') {
					debug.log('stream', `GET /api/stream connected: one multiplexed connection carrying ${STATIONS.length} stations`);
				} else if (e.kind === 'first-audio') {
					debug.log('stream', `first audio from ${e.station.name} (server already dropped its 2 s connect burst)`);
				} else {
					debug.log('stream', `connection lost (${e.reason}), reconnecting in 1 s`);
				}
			});

			// Playback has no connection of its own -- it only ever plays
			// snippets the buffer already holds, and every snippet played is
			// recorded back into the buffer, so the transcript is built from
			// exactly the bytes that were heard.
			async function hopLoop(generation: number) {
				while (generation === hopLoopGeneration) {
					if (player.queuedSeconds() < QUEUE_AHEAD_S) {
						let queued = false;
						for (let attempt = 0; attempt < PICK_ATTEMPTS; attempt++) {
							const station = pickWeighted();
							const snippet = buffer.snippet(station, SNIPPET_S, MIN_SNIPPET_S);
							if (!snippet) continue;
							const scheduled = await player.play(snippet);
							if (scheduled === null || generation !== hopLoopGeneration) break;
							buffer.recordPlayed(snippet, scheduled.audibleAt);
							queued = true;
							debug.log(
								'hop',
								`${station.name}: ${snippet.seconds.toFixed(2)} s snippet = ${snippet.frames} MP3 frames ` +
									`(${fmtBytes(snippet.audio.length)}) + ${snippet.primerFrames} warm-up frames, ` +
									`decoded in ${scheduled.decodeMs.toFixed(0)} ms, queued ${scheduled.leadSeconds.toFixed(2)} s ahead`
							);
							setTimeout(() => {
								if (generation !== hopLoopGeneration) return;
								stationEl.textContent = station.name;
								debug.log('play', `start  ${station.name}`);
							}, scheduled.audibleAt - Date.now());
							setTimeout(() => {
								if (generation === hopLoopGeneration) debug.log('play', `end    ${station.name} (${scheduled.seconds.toFixed(2)} s)`);
							}, scheduled.endsAt - Date.now());
							break;
						}
						if (queued) {
							waitingLogged = false;
						} else if (player.queuedSeconds() === 0 && !waitingLogged) {
							debug.log('hop', `no station has ${MIN_SNIPPET_S} s of fresh audio yet, waiting`);
							waitingLogged = true;
						}
					}
					await sleep(TICK_MS);
				}
			}

			function logStats() {
				const parts = buffer
					.stats(STATIONS)
					.map((s) => `${s.station.name} ${s.kbps.toFixed(0)}`)
					.join(' · ');
				debug.log('stream', `receive rate, kbps: ${parts}`);
			}

			function startHopping() {
				hopping = true;
				buffer.start(STATIONS);
				stationEl.textContent = '-- listening --';
				statsTimer = setInterval(logStats, STATS_INTERVAL_MS);
				void hopLoop(++hopLoopGeneration);
			}

			function stopHopping() {
				hopping = false;
				hopLoopGeneration++;
				if (statsTimer !== null) clearInterval(statsTimer);
				statsTimer = null;
				player.stop();
				buffer.stop();
			}

			// Don't keep hopping stations / streaming audio to a hidden tab.
			document.addEventListener('visibilitychange', () => {
				if (!tunedIn) return;
				if (document.hidden) {
					debug.log('sys', 'tab hidden: stopping playback and closing the stream');
					stopHopping();
				} else if (!hopping) {
					debug.log('sys', 'tab visible again: reconnecting');
					startHopping();
				}
			});

			tuneBtn.addEventListener('click', () => {
				if (tunedIn) return;
				tunedIn = true;
				lastCaptureTime = Date.now();
				renderButtons();
				// AudioContext starts suspended until a user gesture resumes it
				// -- this click is that gesture.
				player.resume();
				debug.log(
					'sys',
					`tune in: Web Audio at ${player.analyser.context.sampleRate} Hz, ${STATIONS.length} stations, ` +
						`${SNIPPET_S} s snippets (min ${MIN_SNIPPET_S} s), next one queued when < ${QUEUE_AHEAD_S} s remains`
				);
				startHopping();
			});

			// Stop everything: playback, the stream, and any transcript still
			// in flight. Aborting the fetch also aborts the request on the
			// server, which passes that on to its OpenRouter calls.
			stopBtn.addEventListener('click', () => {
				if (transcribeAbort) {
					transcribeAbort.abort();
					debug.log('capture', 'stop: transcript request aborted (the server abandons its OpenRouter calls)');
				}
				if (tunedIn) {
					tunedIn = false;
					stopHopping();
					stationEl.textContent = '-- stopped --';
					debug.log('sys', 'stop: playback silenced, stream closed');
				}
				renderButtons();
			});

			// --- transcript -------------------------------------------------

			function clearHint() {
				log.querySelector('.hint')?.remove();
			}

			function appendEntry(timestamp: string, station: string, text: string) {
				clearHint();
				const entry = document.createElement('div');
				entry.className = 'entry';
				const time = document.createElement('span');
				time.className = 'time';
				time.textContent = new Date(timestamp).toLocaleTimeString();
				const from = document.createElement('span');
				from.className = 'from';
				from.textContent = station;
				const body = document.createElement('span');
				body.className = 'text';
				body.textContent = text || '(silence)';
				// appendChild/insertBefore rather than append()/prepend():
				// @cloudflare/workers-types redefines those DOM methods
				// project-wide (see web/CLAUDE.md).
				entry.appendChild(time);
				entry.appendChild(from);
				entry.appendChild(body);
				log.insertBefore(entry, log.firstChild);
			}

			function showOracle(text: string) {
				if (oracleLatest.textContent) {
					const li = document.createElement('li');
					li.textContent = oracleLatest.textContent;
					oracleEarlier.insertBefore(li, oracleEarlier.firstChild);
				}
				oracleLatest.textContent = text;
				oracleLatest.classList.remove('arrive');
				void oracleLatest.offsetWidth; // restart the fade-in animation
				oracleLatest.classList.add('arrive');
			}

			captureBtn.addEventListener('click', async () => {
				transcribing = true;
				renderButtons();

				// Everything played since the *previous* capture (or since
				// tune-in, for the first one), capped so an unusually long gap
				// before capturing can't balloon the clip.
				const now = Date.now();
				const cutoff = Math.max(lastCaptureTime, now - MAX_CAPTURE_MS);
				lastCaptureTime = now;

				const chunks = buffer.since(cutoff);
				if (chunks.length === 0) {
					appendEntry(new Date().toISOString(), '--', '(nothing played yet)');
					showOracle('The spirits have not spoken yet. Listen a little longer.');
					debug.log('capture', 'nothing played since the last transcript, no request sent');
					transcribing = false;
					renderButtons();
					return;
				}

				const labels: string[] = [];
				for (const c of chunks) {
					if (labels.length === 0 || labels[labels.length - 1] !== c.station) labels.push(c.station);
				}
				const labelSummary = labels.join(' -> ');

				const totalLen = chunks.reduce((n, c) => n + c.bytes.length, 0);
				const combined = new Uint8Array(totalLen);
				let offset = 0;
				for (const c of chunks) {
					combined.set(c.bytes, offset);
					offset += c.bytes.length;
				}

				const formData = new FormData();
				formData.append('file', new Blob([combined as BlobPart], { type: 'audio/mpeg' }), 'clip.mp3');

				debug.log(
					'capture',
					`${chunks.length} snippets played since ${fmtClock(cutoff)}, concatenated as-is ` +
						`(${fmtBytes(totalLen)} of MP3) -> POST /api/transcribe`,
					labelSummary
				);
				const fetchStart = performance.now();
				const abort = new AbortController();
				transcribeAbort = abort;

				try {
					const res = await fetch('/api/transcribe', { method: 'POST', body: formData, signal: abort.signal });
					const data = (await res.json()) as
						| { ok: true; text: string; timestamp: string; debug: ModelDebug }
						| { ok: false; error: string };
					const roundTrip = performance.now() - fetchStart;
					if (data.ok) {
						logModelCalls(data.debug, roundTrip);
						appendEntry(data.timestamp, labelSummary, data.text);
						showOracle(data.text || '…only static…');
					} else {
						debug.log('error', `/api/transcribe ${res.status} after ${roundTrip.toFixed(0)} ms: ${data.error}`);
						appendEntry(new Date().toISOString(), labelSummary, `[transcript failed: ${data.error}]`);
						showOracle('The connection to the other side faded. Ask again.');
					}
				} catch (err) {
					if (abort.signal.aborted) {
						appendEntry(new Date().toISOString(), labelSummary, '(transcript cancelled)');
						return;
					}
					debug.log('error', `/api/transcribe request failed: ${err}`);
					appendEntry(new Date().toISOString(), labelSummary, `[transcript failed: ${err}]`);
					showOracle('The connection to the other side faded. Ask again.');
				} finally {
					transcribeAbort = null;
					transcribing = false;
					renderButtons();
				}
			});

			interface ModelDebug {
				clipBytes: number;
				transcription: { model: string; ms: number; attempts: number; usage?: Record<string, unknown>; rawText: string };
				translation:
					| null
					| { error: string }
					| {
							model: string;
							provider?: string;
							ms: number;
							attempts: number;
							usage?: Record<string, unknown>;
							systemPrompt: string;
							input: string;
							text: string;
					  };
			}

			// A backup request is sent when an attempt hangs (see hedge.ts);
			// say so, since only the winning attempt's usage is reported.
			const attemptsNote = (n: number) => (n > 1 ? ` [${n} requests: the first stalled, a backup answered]` : '');

			function logModelCalls(d: ModelDebug, roundTripMs: number) {
				const t = d.transcription;
				debug.log('llm', `-> ${t.model} (server-side): ${fmtBytes(d.clipBytes)} of MP3`);
				const tCost = num(t.usage, 'cost');
				debug.log(
					'llm',
					`<- ${t.ms} ms, ${num(t.usage, 'seconds')} s of audio billed, ` +
						`${num(t.usage, 'input_tokens')} in / ${num(t.usage, 'output_tokens')} out tokens, ${fmtUsd(tCost)}${attemptsNote(t.attempts)}`,
					t.rawText || '(empty: nothing intelligible to transcribe)'
				);

				let trCost = 0;
				const tr = d.translation;
				if (tr === null) {
					debug.log('llm', 'translation skipped: empty transcript');
				} else if ('error' in tr) {
					debug.log('error', `translation failed, showing the untranslated text: ${tr.error}`);
				} else {
					debug.log(
						'llm',
						`-> ${tr.model}${tr.provider ? ` via ${tr.provider}` : ''}, temperature 0, 2 messages:`,
						`[system] ${tr.systemPrompt}\n[user]   ${tr.input}`
					);
					trCost = num(tr.usage, 'cost');
					debug.log(
						'llm',
						`<- ${tr.ms} ms, ${num(tr.usage, 'prompt_tokens')} in / ${num(tr.usage, 'completion_tokens')} out tokens, ${fmtUsd(trCost)}${attemptsNote(tr.attempts)}`,
						tr.text
					);
				}

				transcriptCount++;
				sessionCost += tCost + trCost;
				debug.log(
					'cost',
					`this transcript ${fmtUsd(tCost + trCost)} (round trip ${roundTripMs.toFixed(0)} ms); ` +
						`session total ${fmtUsd(sessionCost)} over ${transcriptCount} transcript${transcriptCount === 1 ? '' : 's'}`
				);
			}

			setMode(initialMode());
			// Idle shimmer from the start; it swells once there's audio.
			waveform.start();
			debug.log('sys', `page ready: ${STATIONS.length} stations configured, waiting for tune in`);
		</script>

